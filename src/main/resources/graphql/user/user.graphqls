type User {
    id: ID!
    name: String!
    email: String!
    cart: Cart!
    batchCart: Cart!   # @BatchMapping 확인용: cart와 같은 값을 여러 User에 대해 한 번에 조회
    createdAt: DateTime!
}

input AddUserInput {
    name: String!
    email: String!
}

extend type Query {
    getUser(userId: ID!): User!
}

extend type Mutation {
    addUser(addUserInput: AddUserInput!): User!
}
